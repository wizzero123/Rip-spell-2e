import java.util.Scanner;

public class rip {
	public static void main( String[] args ) {
		int rip = 0;
		int count = 2;
		int totalDam = 0;
		int turn = 0;
		int turnsPassed = 0
		
		Scanner in = new Scanner(System.in);
		while (true) {
			
			//set up var counts
			rip = rip + count;
			totalDam = totalDam + rip;

			//ask for input
			System.out.print("Is rip active (y/n): ");
			String scan = in.nextLine();
			scan = scan.toLowerCase();
			
			//uses inputs to print the damage taken, the total damage dealt, and the number of turns active
			if(scan.charAt(0) == 'y'){
			
				System.out.println("\nDamage this turn was: " + rip);
				System.out.println("Total damage taken is: " + totalDam);
				turnsPassed = turn+1;
				System.out.println( turnsPassed + " turns have passed\n");
				turn += 1;
			}

			//breaks the loop if the spell has been dispelled, run out of duration, or finished its job
			else if(scan.charAt(0) == 'n'){
				System.out.println("Rip has ended.");
				break;
			}
			else{
				System.out.println("Please type 'yes' or 'no'");
			}
		}
	}
}

		
